{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fresh-session-result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "independent-agent",
            "human",
            "self"
          ]
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "identity",
        "context_id"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "enum": [
              "purpose",
              "architecture",
              "subsystem",
              "operations",
              "decision",
              "authority",
              "verification"
            ]
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "topic",
          "answer",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "snapshot_digest",
    "reviewer",
    "verdict",
    "answers",
    "limitations"
  ],
  "additionalProperties": false
}
