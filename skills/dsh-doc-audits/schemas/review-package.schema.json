{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-package",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "root",
        "head",
        "binding_digest"
      ],
      "additionalProperties": false
    },
    "bound_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "current_inventory": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "author_context_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "architecture",
              "subsystem",
              "runbook",
              "reference",
              "glossary",
              "instructions",
              "backlog",
              "decision"
            ]
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "current_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "separation_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "tier",
          "responsibility",
          "evidence",
          "current_sources",
          "separation_reason"
        ],
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "create",
              "edit",
              "move",
              "demote_to_historical"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "preserve": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diff": {
      "type": "string"
    },
    "review_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assurance": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "plan_digest",
    "content_digest",
    "repository",
    "bound_paths",
    "current_inventory",
    "author_context_id",
    "authority_candidates",
    "operations",
    "preserve",
    "write_scope",
    "open_conflicts",
    "verification",
    "rollback",
    "diff",
    "review_questions",
    "assurance"
  ],
  "additionalProperties": false
}
