{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proposal",
  "type": "object",
  "properties": {
    "author_context_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "architecture",
              "subsystem",
              "runbook",
              "reference",
              "glossary",
              "instructions",
              "backlog",
              "decision"
            ]
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "current_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "separation_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "tier",
          "responsibility",
          "evidence",
          "current_sources",
          "separation_reason"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "create": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "content",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "edit": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "content",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "move": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "demote_to_historical": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "content",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "create",
        "edit",
        "move",
        "demote_to_historical",
        "preserve"
      ],
      "additionalProperties": false
    },
    "write_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "link_repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "path",
          "targets"
        ],
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rollback": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "open_conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "user_decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "author_context_id",
    "authority_candidates",
    "files",
    "write_scope",
    "link_repairs",
    "verification",
    "rollback",
    "open_conflicts"
  ],
  "additionalProperties": false
}
